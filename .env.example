# ============================================================
# Doxify 配置文件
# 复制为 .env 并填入实际值：cp .env.example .env
# ============================================================

# 目标 LLM API 地址（OpenAI 兼容格式的 chat/completions 端点）
TARGET_API_URL=https://your-api-endpoint.com/v1/chat/completions

# 目标 LLM API 密钥
TARGET_API_KEY=your_api_key_here

# 实际部署的模型名（VLM 与翻译均使用此模型）
ACTUAL_MODEL_NAME=kimi26

# 服务监听端口
GATEWAY_PORT=4000

# 目标 LLM 请求超时（秒）
LLM_TIMEOUT=300

# 每页 VLM 识别超时（秒）
PAGE_TIMEOUT=120

# PDF 转图片的 DPI（越高越清晰但越慢，建议 150-300）
PDF_DPI=200

# 单文件内并发 Worker 数
CONCURRENCY=5

# 启用并发的最小页数（小于此值顺序处理）
CONCURRENCY_THRESHOLD=10

# 全局最大同时发出的 VLM API 请求数（多文件×多Worker 共享此上限）
MAX_CONCURRENT_REQUESTS=8

# MinerU 本地处理超时（秒，默认 1800）
MINERU_TIMEOUT=1800

# MinerU 性能调优（Apple Silicon 必备）
# 背景：MinerU 3.0.x 不识别 MPS 显存，会把 batch_ratio 压到 1（最慢档）。
# 下面 4 个变量会在调用 mineru 子进程时注入，外部已设置的不覆盖。
# - MINERU_VIRTUAL_VRAM_SIZE: 谎报显存（GB），驱动 batch_ratio 选择
#     ≥32 → batch_ratio=16, ≥16 → 8, ≥8 → 4, ≥6 → 2, 其余 → 1
# - MINERU_HYBRID_BATCH_RATIO: hybrid 后端直接指定 batch_ratio（最高优先级）
# - MINERU_PDF_RENDER_THREADS: PDF→图片渲染线程数（默认 4）
# - MINERU_DEVICE_MODE: 强制设备；M-series 用 mps；Intel/无 GPU 改 cpu
MINERU_VIRTUAL_VRAM_SIZE=32
MINERU_HYBRID_BATCH_RATIO=16
MINERU_PDF_RENDER_THREADS=8
MINERU_DEVICE_MODE=mps

# PaddleOCR 本地 OCR 并发页数（M5 Max 建议 4，普通机器建议 1-2）
LOCAL_OCR_CONCURRENCY=4

# PaddleOCR-VL 块间并发数（多个 PDF 块同时处理）。MLX 路径下实测约 1.2× 提速、调大收益递减；
# CPU 回退路径会自动按 1 处理（单块已吃满 CPU），无需手改。
PADDLE_VL_CONCURRENCY=3

# ── PaddleOCR-VL MLX 加速（Apple Silicon，可选但强烈推荐）──
# 把最慢的 VLM 识别卸载到独立的 mlx_vlm.server 进程（MLX/GPU），实测约 20× 快于 CPU
# （M5 Max 单页 ~45s → ~2.2s）。start.sh 会在启动 Doxify 前自动拉起该 server；
# server 不可达时 PaddleOCR-VL 自动回退到 CPU，不影响其它模式。
#
# 一次性创建独立 venv（不要装进 mineru 环境，会破坏 MinerU 的 transformers<5 约束）：
#   python3.12 -m venv ~/paddleocr_vl_venv
#   ~/paddleocr_vl_venv/bin/pip install "paddlepaddle==3.2.1" -i https://www.paddlepaddle.org.cn/packages/stable/cpu/
#   ~/paddleocr_vl_venv/bin/pip install -U "paddleocr[doc-parser]" "mlx-vlm>=0.3.11"
PADDLE_MLX_ENABLED=1
PADDLE_MLX_VENV=~/paddleocr_vl_venv
PADDLE_MLX_SERVER_PORT=8111
PADDLE_MLX_MODEL_NAME=PaddlePaddle/PaddleOCR-VL-1.6
