# ============================================================
# DoxifySlim 配置文件
# 复制为 .env 并填入实际值：cp .env.example .env
# （安装脚本 install.sh / install.bat 会自动复制一份）
# ============================================================

# 目标 LLM API 地址（OpenAI 兼容格式的 chat/completions 端点）
TARGET_API_URL=https://your-api-endpoint.com/v1/chat/completions

# 目标 LLM API 密钥
TARGET_API_KEY=your_api_key_here

# 实际部署的模型名（Kimi VLM 解析与 Markdown 翻译均使用此模型）
ACTUAL_MODEL_NAME=kimi26

# 服务监听端口
GATEWAY_PORT=4000

# 目标 LLM 请求超时（秒）
LLM_TIMEOUT=300

# 每页 VLM 识别超时（秒）
PAGE_TIMEOUT=120

# PDF 转图片的 DPI（越高越清晰但越慢，建议 150-300）
PDF_DPI=200

# 单文件内并发 Worker 数
CONCURRENCY=5

# 启用并发的最小页数（小于此值顺序处理）
CONCURRENCY_THRESHOLD=10

# 全局最大同时发出的 VLM API 请求数（多文件×多Worker 共享此上限）
MAX_CONCURRENT_REQUESTS=8

# 翻译：每块最大字符数
TRANSLATE_CHUNK_CHARS=3000

# 翻译：默认目标语言
TRANSLATE_TARGET_LANG=中文
