# ============================================================
# DoxifySlim 配置文件
# 复制为 .env 并填入实际值（安装脚本 install.sh / install.bat 会自动复制一份）
#   Windows: copy .env.example .env      macOS/Linux: cp .env.example .env
# ============================================================

# ── 必填：LLM 网关 ──────────────────────────────────────────

# 目标 LLM API 地址（OpenAI 兼容格式的 chat/completions 端点）
TARGET_API_URL=https://your-api-endpoint.com/v1/chat/completions

# 目标 LLM API 密钥
TARGET_API_KEY=your_api_key_here

# 网关上注册的模型名（PDF 解析、Markdown 翻译、Office 翻译共用）。
# 注意：这是网关接受的名字，不一定等于背后真实的模型——例如某些网关把 GLM-5.3-Flash
# 挂在旧名字 kimi-2.6 下。填网关认的那个名字即可，真实模型由下面的 LLM_PROFILE 描述。
ACTUAL_MODEL_NAME=kimi-2.6

# 模型档案：按网关背后**真实**的模型选，决定发给它的「关闭思考模式」参数。不同模型
# 协议不同，选错会把整段推理过程当成正文写进产物。可选值：
#   glm53flash  — GLM-5.3-Flash（当前默认；reasoning_effort=low，GLM 不能完全关思考，程序会再剥一遍）
#   kimi26      — Kimi 2.6 / Qwen 系（chat_template_kwargs.thinking=false）
LLM_PROFILE=glm53flash

# ── 服务 ────────────────────────────────────────────────────

# 服务监听端口
GATEWAY_PORT=4000

# 日志文件路径（默认 app.py 同目录的 gateway.log）
# DOXIFY_LOG_FILE=

# 进度心跳：每隔多少秒记一行各文件的进度（+N 表示本周期完成页数，长期 +0 即卡住）。<=0 关闭
HEARTBEAT_SEC=60

# ── PDF 解析（远程 VLM）──────────────────────────────────────

# LLM 请求总超时（秒）
LLM_TIMEOUT=300

# 单页 VLM 识别超时（秒）；重试时递增，被截断时翻倍
PAGE_TIMEOUT=120

# PDF 转图片的 DPI（越高越清晰但越慢，建议 150-300）。注意：改它会让页缓存全部失效
PDF_DPI=200

# 单文件内并发 Worker 数
CONCURRENCY=5

# 启用并发的最小页数（小于此值顺序处理）
CONCURRENCY_THRESHOLD=10

# 全局最大同时发出的 API 请求数（多文件 × 多 Worker 共享此上限）
MAX_CONCURRENT_REQUESTS=8

# 是否丢弃「只是表格框线」的矢量图簇（表格已由 VLM 转成 Markdown，再留一张图片是重复）。
# 判据：全是横平竖直的线且区域内有文字 → 表格 → 丢；有曲线/斜线 → 真图表 → 留。设 0 退回旧行为
FIGURE_DROP_TABLES=1

# ── 翻译（Markdown 与 Office 共用）──────────────────────────

# 同时在途的翻译流数量（嵌套在 MAX_CONCURRENT_REQUESTS 之内，覆盖整个流的生命周期）
TRANSLATE_CONCURRENCY=3

# Markdown 翻译：每块最大字符数
TRANSLATE_CHUNK_CHARS=3000

# 单块流式翻译的 max_tokens；译文为空时会以两倍再试一次
TRANSLATE_MAX_TOKENS=6000

# 流式翻译首段缓冲字符数：先攒够这么多再做「无标签推理」检查，防止推理过程当译文流出
STREAM_HEAD_CHARS=240

# 默认翻译目标语言
TRANSLATE_TARGET_LANG=中文

# ── 作业注册表（断线重连）──────────────────────────────────

# 内存中保留的已完成作业数（运行中的永不淘汰）。翻译作业逐 token 记事件，长文档可达数十 MB
JOB_HISTORY_MAX=20

# 每个订阅者的事件队列上限，应大于一次完整重放的事件数
SUBSCRIBER_QUEUE_MAX=10000
